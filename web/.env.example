# The AI assistant needs at least one key. All of these have free tiers.
# Add several: when one hits its daily limit, the next one is used.
# Put real keys in .env.local (never commit them) or in Vercel's Environment Variables.

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter (use a model ID ending in ":free"): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Any other OpenAI-compatible chat-completions endpoint (optional)
# AI_CUSTOM_URL=https://example.com/v1/chat/completions
# AI_CUSTOM_KEY=
# AI_CUSTOM_MODEL=

# Order to try providers in
# AI_PROVIDER_ORDER=gemini,groq,openrouter,custom
